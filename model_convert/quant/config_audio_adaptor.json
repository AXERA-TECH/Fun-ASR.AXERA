{
  "model_type": "ONNX",
  "npu_mode": "NPU3",
  "quant": {
    "input_configs": [
      {
        "tensor_name": "audio_encoder_out",
        "calibration_dataset": "calib_data/audio_encoder_out.tar.gz",
        "calibration_format": "Numpy",
        "calibration_size": -1
      },
      {
        "tensor_name": "audio_encoder_out_lens",
        "calibration_dataset": "calib_data/audio_encoder_out_lens.tar.gz",
        "calibration_format": "Numpy",
        "calibration_size": -1
      }
    ],
    "layer_configs": [
      {
        "start_tensor_names": ["DEFAULT"],
        "end_tensor_names": ["DEFAULT"],
        "data_type": "U16"
      },
      {
        "op_type": "MatMul",
        "data_type": "U16"
      },
      {
        "op_type": "LayerNormalization",
        "data_type": "U16"
      },
      {
        "op_type": "Softmax",
        "data_type": "U16"
      },
      {
        "op_type": "Add",
        "data_type": "U16"
      },
      {
        "op_type": "Mul",
        "data_type": "U16"
      },
      {
        "op_type": "Where",
        "data_type": "U16"
      },
      {
        "op_type": "Cast",
        "data_type": "U16"
      }
    ],
    "calibration_method": "MinMax",
    "enable_smooth_quant": true,
    "conv_bias_data_type": "FP32",
    "precision_analysis": true,
    "precision_analysis_method": "PerLayer",
    "precision_analysis_mode": "Reference",
